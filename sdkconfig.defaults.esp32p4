# ---------------------------------------------------------
# ESP-IDF v5.5 sdkconfig.defaults.esp32p4 для Murzik
# Плата: Waveshare ESP32-P4-WIFI6-Touch-LCD-3.4C (32MB Flash)
# ---------------------------------------------------------

# === 1. Target & Board ===
CONFIG_IDF_TARGET_ESP32P4=y
CONFIG_BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_3_4C=y

# === 2. Partition Table ===
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_murzik.csv"

# === 3. Audio & ESP-SR (Audio Front End) ===
CONFIG_ESP_SR_ENABLE=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_AUDIO_INPUT_SAMPLE_RATE=24000
CONFIG_AUDIO_OUTPUT_SAMPLE_RATE=24000
CONFIG_AUDIO_INPUT_REFERENCE=y
CONFIG_ESP_SR_AFE_VC_MODE=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Audio Codec (ES8311 + ES7210 for P4)
CONFIG_ESP_CODEC_DEV_ENABLE=y
CONFIG_ESP_CODEC_DEV_SUPPORT_ES8311=y
CONFIG_ESP_CODEC_DEV_SUPPORT_ES7210=y
CONFIG_AUDIO_BOARD_CUSTOM=y

# Wake Word Models (XiaoClaw/Mimiclaw)
# ⚠️ ВНИМАНИЕ: Проверьте актуальные имена моделей для P4 через idf.py menuconfig
# Component config → ESP Speech Recognition → Wake Word Engine
CONFIG_SR_WN_WN10_NIHAO_XIAO_ZHI=y

# === 4. Display & LVGL ===
CONFIG_LCD_MIPI_DSI_LANE_BITRATE_MBPS=1500
CONFIG_LCD_MIPI_DSI_LANE_NUM=2
CONFIG_LCD_BIT_PER_PIXEL=16
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_SNAPSHOT=y

# === 5. Camera OV5647 (MIPI-CSI Native) ===
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_XIAOZHI_ENABLE_CAMERA_DEBUG_MODE=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
# MIPI-CSI Stability (P4 Specific)
CONFIG_CAM_CTLR_MIPI_CSI_ISR_CACHE_SAFE=y
CONFIG_ISP_ISR_IRAM_SAFE=y

# === 6. WiFi Remote (ESP32-C6 via SDIO) ===
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_SDIO_HOST_ID=1
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# SDIO Host Stability
CONFIG_DRIVER_SDMMC_IRQ_HANDLER_IN_IRAM=y

# === 7. Bootloader Settings ===
CONFIG_BOOTLOADER_SIZE=0xF000
CONFIG_PARTITION_TABLE_OFFSET=0x11000

# === 8. Flash Size ===
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# === 9. PSRAM / MSPI (ESP32-P4 Specific) ===
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n

# === 10. MCP / Mimiclaw Dependencies ===
CONFIG_MCP_ENABLED=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# === 11. Debug Logging ===
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_DYNAMIC=y
