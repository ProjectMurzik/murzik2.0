# ---------------------------------------------------------
# ESP-IDF v5.5 sdkconfig.defaults.esp32p4 для Murzik
# Плата: Waveshare ESP32-P4-WIFI6-Touch-LCD-3.4C (32MB Flash)
# ---------------------------------------------------------

# === 1. Target & Board ===
CONFIG_IDF_TARGET_ESP32P4=y
CONFIG_BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_3_4C=y

# === 2. Partition Table ===
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_murzik.csv"

# === 3. Audio & ESP-SR (Audio Front End) ===
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_ESP_SR_AFE_VC_MODE=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_ESP_SR_TRACKING_MODE=y
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_SR_WN_WN9L_NIHAOXIAOZHI_TTS3=y

# Audio Codec (ES8311 + ES7210 for P4)
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y

# === 4. Display & LVGL ===
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_SNAPSHOT=y

# === 5. Camera OV5647 (MIPI-CSI Native) ===
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_XIAOZHI_ENABLE_CAMERA_DEBUG_MODE=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
# MIPI-CSI Stability (P4 Specific)
CONFIG_CAM_CTLR_MIPI_CSI_ISR_CACHE_SAFE=y
CONFIG_ISP_ISR_IRAM_SAFE=n

# === 6. WiFi Remote (ESP32-C6 via SDIO) - FIX EARLY INIT ===
CONFIG_ESP_WIFI_REMOTE_ENABLED=y

# ✅ МИНИМАЛЬНЫЕ РАЗМЕРЫ ДЛЯ ВНУТРЕННЕЙ RAM:
# Уменьшаем буферы, чтобы освободить место для mempool на старте
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_TX_BA_WIN=2
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=8
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# === 7. Partition Table Offset ===
CONFIG_PARTITION_TABLE_OFFSET=0x11000

# === 8. Flash Size ===
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# === 9. PSRAM / MSPI (ESP32-P4 Specific) ===
# Критические настройки для использования 32MB PSRAM как fallback для malloc
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SIZE=-1
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
 

# === 10. MCP / Mimiclaw Dependencies ===
CONFIG_MIMI_MCP_CLIENT_ENABLE=y
CONFIG_MIMI_MCP_REMOTE_HOST=""
CONFIG_MIMI_MCP_REMOTE_PORT=8080
CONFIG_MIMI_MCP_TIMEOUT_MS=10000
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# === 11. C++ Exceptions & RTTI (CRITICAL FOR BUILD) ===
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# === 12. Debug Logging ===
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y

# === 13. Task Stack Sizes (FIX FOR NVS WRITE CRASH) ===
# Увеличиваем стек основного таска и HTTP-сервера для безопасной записи в NVS (Flash)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_HANDLERS=16

# === 14. App Specific ===
CONFIG_XIAOZHI_WEBSOCKET_URL="wss://api.tenclass.net/xiaozhi/v1/"

CONFIG_LANGUAGE_RU_RU=y
