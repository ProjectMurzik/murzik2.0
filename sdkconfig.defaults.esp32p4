# ---------------------------------------------------------
# ESP-IDF v5.5 sdkconfig.defaults.esp32p4 для Murzik
# Плата: Waveshare ESP32-P4-WIFI6-Touch-LCD-3.4C (32MB Flash)
# ---------------------------------------------------------

# === 1. Target & Board ===
CONFIG_IDF_TARGET_ESP32P4=y
CONFIG_BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_3_4C=y

# === 2. Partition Table ===
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_murzik.csv"

# === 3. Audio & ESP-SR (Audio Front End) ===
CONFIG_ESP_SR_ENABLE=y
CONFIG_ESP_SR_AFE_SUPPORTED=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_AUDIO_INPUT_SAMPLE_RATE=24000
CONFIG_AUDIO_OUTPUT_SAMPLE_RATE=24000
CONFIG_AUDIO_INPUT_REFERENCE=y
CONFIG_ESP_SR_AFE_VC_MODE=y

# === 4. Display & LVGL Fixes ===
CONFIG_LCD_MIPI_DSI_LANE_BITRATE_MBPS=1500
CONFIG_LCD_MIPI_DSI_LANE_NUM=2
CONFIG_LCD_BIT_PER_PIXEL=16

# 🔥 КРИТИЧНО: Исправление ошибки lv_imgfont_create в LVGL v9
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# === 5. Camera OV5647 ===
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y

# === 6. WiFi Remote (ESP32-C6 via SDIO) ===
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_SDIO_HOST_ID=1

# === 7. Bootloader Settings ===
CONFIG_BOOTLOADER_SIZE=0xF000
CONFIG_PARTITION_TABLE_OFFSET=0x11000

# === 8. Flash Size (КРИТИЧНО!) ===
# Решает ошибку: "Partitions tables occupies 34.1MB ... does not fit in configured flash size 2MB"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
